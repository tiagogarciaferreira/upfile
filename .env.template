# APP
SERVER_PORT=8080
HOSTNAME=http://example.com
API_VERSION=1.0
# POSTGRES
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=myapp-db
POSTGRES_USER=my-user
POSTGRES_PASSWORD=my-password
# SSL
SSL_KEY_STORE=classpath:name-tls-keystore.p12
SSL_STORE_PASSWORD=password
SSL_KEY_ALIAS=tls-alias
# SPRING
SPRING_PROFILES_ACTIVE=local
SPRING_SQL_INIT_DATA_LOCATIONS=classpath:db/data/afterMigration.sql
SPRING_FLYWAY_LOCATIONS=classpath:db/migration
# LOGS
LOG_PATH=/logs
LOG_CONFIG_PATH=classpath:logback-spring.xml
# SECURITY
JWT_PUBLIC_KEY=classpath:jwt-public-key.jwk
JWT_PRIVATE_KEY=classpath:jwt-private-key.jwk
# USERS
USER_READ=user-read
USER_READ_PASSWORD=password
USER_WRITE=user-admin
USER_WRITE_PASSWORD=password
# RUSTFS
RUSTFS_PORT=9000
RUSTFS_ADMIN_ROOT_ACCESS_KEY=root-access-key
RUSTFS_ADMIN_ROOT_SECRET_KEY=root-secret-key
RUSTFS_CONSOLE_PORT=9001
RUSTFS_CONSOLE_ENABLE=true
RUSTFS_BUCKET_NAME=bucket-name
RUSTFS_BUCKET_ACCESS_KEY=bucket-access-key
RUSTFS_BUCKET_SECRET_KEY=bucket-secret-key
RUSTFS_APP_UPLOAD_ACCESS_KEY=app-upload-access-key
RUSTFS_APP_UPLOAD_SECRET_KEY=app-upload-secret-key